{
  "name": "zoomclone",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "test:runtimes": "node scripts/coordinator-build.ts && node scripts/storage-check.ts --recovery --runtimes",
    "test:recovery": "node scripts/coordinator-build.ts && node scripts/storage-check.ts --recovery",
    "test:storage": "node scripts/storage-check.ts",
    "test": "node --test tests/logical-clock.test.ts tests/coordinator.test.ts tests/meeting-engine.test.ts tests/runtime-agent.test.ts tests/runtime-rpc.test.ts tests/discovery.test.ts tests/discovery-rpc.test.ts tests/discovered-helpers.test.ts",
    "start:discovery": "node scripts/discovery-peer.ts",
    "build:coordinator": "node scripts/coordinator-build.ts",
    "test:coordinator": "node scripts/coordinator-build.ts --check",
    "test:consensus": "node scripts/coordinator-build.ts --consensus",
    "demo:coordinator": "node scripts/coordinator-scenario.ts",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
