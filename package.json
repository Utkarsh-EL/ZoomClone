{
  "name": "zoomclone",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "test:recovery": "node scripts/coordinator-build.ts && node scripts/storage-check.ts --recovery",
    "test:storage": "node scripts/storage-check.ts",
    "test": "node --test tests/protocol.test.ts tests/integration.test.ts tests/p2p.test.ts tests/coordination.test.ts tests/video.test.ts tests/coordinator.test.ts tests/meeting-engine.test.ts",
    "build:coordinator": "node scripts/coordinator-build.ts",
    "test:coordinator": "node scripts/coordinator-build.ts --check",
    "test:consensus": "node scripts/coordinator-build.ts --consensus",
    "demo:coordinator": "node scripts/coordinator-scenario.ts",
    "typecheck": "tsc",
    "demo": "node p2p_demo.ts",
    "demo:coordination": "node coord_demo.ts",
    "demo:video": "node video_demo.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
